# Local secrets for this workspace. Copy this file to .env and fill it in.
# .env is gitignored. Do not commit it.
#
# Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Use "Create API token", not a scoped token, so it covers Jira and Confluence.

ATLASSIAN_USER=
ATLASSIAN_TOKEN=

# Optional. Defaults to https://eaflood.atlassian.net
# ATLASSIAN_BASE_URL=https://eaflood.atlassian.net

# Optional. Defaults to https://eaflood.atlassian.net/wiki
# CONFLUENCE_BASE_URL=https://eaflood.atlassian.net/wiki

# Optional. Defaults to DEFRA. Used when a pull request is given as a repo name only.
# GITHUB_ORG=DEFRA

# Optional fetch limits. A commented line leaves the default in the script.
# JIRA_MAX_RELATED=10
# JIRA_RELEASE_MAX_ISSUES=100
# CONFLUENCE_MAX_FOLDER_PAGES=50
# CONFLUENCE_SEARCH_LIMIT=25
# CONFLUENCE_MAX_CHILDREN=10

# Optional. Defaults to markdown.
# JIRA_RELEASE_DESCRIPTION_FORMAT=markdown

# Optional. Defaults to Documentation.
# JIRA_RELATED_WORK_CATEGORY=Documentation
