#!/bin/sh
set -e

. "$(CDPATH= cd -- "$(dirname "$0")" && pwd)/common.sh"
rulesync_paths
rulesync_tool

if [ ! -d "$SNAPSHOT/.rulesync" ] || [ ! -f "$ROOT/.tmp/rulesync-tool" ]; then
  echo "No rulesync snapshot for this checkout." >&2
  echo "Run bin/rulesync/install-hooks once, then bin/rulesync/sync-worktree." >&2
  exit 1
fi

saved=$(cat "$ROOT/.tmp/rulesync-tool")
if [ "$saved" != "$TOOL" ]; then
  echo "RULESYNC_TOOL is $TOOL and the last sync was $saved." >&2
  echo "Run bin/rulesync/sync-worktree." >&2
  exit 1
fi

root_rule_rel=
for file in "$ROOT/.rulesync/rules/"*.md; do
  if [ -f "$file" ] && grep -q '^root: true$' "$file"; then
    root_rule_rel=rules/$(basename "$file")
    break
  fi
done

map_to_source() {
  tool_rel=$1
  case "$TOOL" in
    cursor)
      case "$tool_rel" in
        rules/*.mdc) printf 'rules/%s.md\n' "$(basename "$tool_rel" .mdc)" ;;
        skills/*) printf '%s\n' "$tool_rel" ;;
        *) return 1 ;;
      esac
      ;;
    claude)
      case "$tool_rel" in
        CLAUDE.md)
          if [ -z "$root_rule_rel" ]; then
            return 1
          fi
          printf '%s\n' "$root_rule_rel"
          ;;
        rules/*|skills/*) printf '%s\n' "$tool_rel" ;;
        *) return 1 ;;
      esac
      ;;
  esac
}

parse_diff() {
  actual=$1
  expected=$2
  out=$3
  raw=$work/raw-diff
  : > "$out"
  if [ ! -d "$actual" ] || [ ! -d "$expected" ]; then
    echo "Could not compare $actual with $expected." >&2
    exit 1
  fi
  set +e
  diff -rq "$actual" "$expected" > "$raw"
  status=$?
  set -e
  if [ "$status" -gt 1 ]; then
    echo "Could not compare $actual with $expected." >&2
    exit 1
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    [ -z "$line" ] && continue
    case "$line" in
      Files\ *)
        left=${line#Files }
        left=${left%% and *}
        rel=${left#"$actual"/}
        printf 'edit\t%s\n' "$rel" >> "$out"
        ;;
      "Only in ${actual}"*)
        rest=${line#Only in }
        dir=${rest%%: *}
        name=${rest#*: }
        name=${name# }
        prefix=${dir#"$actual"}
        prefix=${prefix#/}
        if [ -n "$prefix" ]; then rel="$prefix/$name"; else rel=$name; fi
        printf 'add\t%s\n' "$rel" >> "$out"
        ;;
      "Only in ${expected}"*)
        rest=${line#Only in }
        dir=${rest%%: *}
        name=${rest#*: }
        name=${name# }
        prefix=${dir#"$expected"}
        prefix=${prefix#/}
        if [ -n "$prefix" ]; then rel="$prefix/$name"; else rel=$name; fi
        printf 'delete\t%s\n' "$rel" >> "$out"
        ;;
      *)
        echo "Unparsed diff line: $line" >&2
        exit 1
        ;;
    esac
  done < "$raw"
}

plain_description() {
  awk '
    /^description: >-[[:space:]]*$/ { folded = 1; next }
    folded && /^[[:space:]]/ { sub(/^[[:space:]]+/, ""); printf "%s ", $0; next }
    folded { exit }
    /^description: / { sub(/^description: /, ""); print; exit }
  ' "$1" | sed 's/  */ /g; s/ *$//'
}

replace_body() {
  src=$1
  gen=$2
  tmp=$work/body
  awk '
    function slurp(path, which,    line, marks, seen) {
      marks = 0
      seen = 0
      while ((getline line < path) > 0) {
        if (line == "---") {
          marks++
          if (which == "fm" && marks <= 2) print line
          continue
        }
        if (marks == 1) {
          if (which == "fm") print line
          continue
        }
        if (which == "body") {
          if (!seen && line == "") continue
          seen = 1
          print line
        }
      }
      close(path)
    }
    BEGIN {
      slurp(ARGV[1], "fm")
      print ""
      slurp(ARGV[2], "body")
      exit
    }
  ' "$src" "$gen" > "$tmp"
  mv "$tmp" "$src"
}

claude_edit() {
  src=$1
  gen=$2
  base=$(basename "$src")
  case "$base" in
    package.json)
      if cmp -s "$gen" "$ROOT/.rulesync/skills/lib/package.json"; then
        ln -sfn ../lib/package.json "$src"
      else
        cp "$gen" "$src"
      fi
      return
      ;;
    *.js|*.sh|Dockerfile|*.json)
      cp "$gen" "$src"
      return
      ;;
  esac

  if [ ! -f "$src" ]; then
    mkdir -p "$(dirname "$src")"
    cp "$gen" "$src"
    return
  fi

  replace_body "$src" "$gen"
  if [ "$base" = SKILL.md ]; then
    src_desc=$(plain_description "$src")
    gen_desc=$(plain_description "$gen")
    if [ "$src_desc" != "$gen_desc" ] && [ -n "$gen_desc" ]; then
      awk -v desc="$gen_desc" '
        !done && /^description: / && $0 !~ /^description: >-/ {
          print "description: " desc
          done = 1
          next
        }
        { print }
      ' "$src" > "$work/desc"
      mv "$work/desc" "$src"
    fi
  fi
}

work="$ROOT/.tmp/rulesync-compare"
rm -rf "$work"
mkdir -p "$work/tree"
trap 'rm -rf "$work"' EXIT
cp -a "$SNAPSHOT/." "$work/tree/"

rulesync_build
rulesync_run_in "$work/tree" generate --targets "$TARGET" --silent

case "$TOOL" in
  cursor)
    actual="$ROOT/.cursor"
    expected="$work/tree/.cursor"
    ;;
  claude)
    actual="$ROOT/.claude"
    expected="$work/tree/.claude"
    ;;
esac

if [ ! -d "$actual" ]; then
  echo "No $actual directory. Run bin/rulesync/sync-worktree." >&2
  exit 1
fi

parse_diff "$actual" "$expected" "$work/tool-raw"
if [ "$TOOL" = claude ]; then
  if [ -f "$ROOT/CLAUDE.md" ] && [ -f "$work/tree/CLAUDE.md" ]; then
    if ! cmp -s "$ROOT/CLAUDE.md" "$work/tree/CLAUDE.md"; then
      printf 'edit\tCLAUDE.md\n' >> "$work/tool-raw"
    fi
  elif [ -f "$ROOT/CLAUDE.md" ]; then
    printf 'add\tCLAUDE.md\n' >> "$work/tool-raw"
  elif [ -f "$work/tree/CLAUDE.md" ]; then
    printf 'delete\tCLAUDE.md\n' >> "$work/tool-raw"
  fi
fi

: > "$work/mapped"
while IFS=$(printf '\t') read -r action rel || [ -n "$action" ]; do
  [ -z "$action" ] && continue
  if ! source_rel=$(map_to_source "$rel"); then
    echo "No .rulesync path for $rel." >&2
    exit 1
  fi
  printf '%s\t%s\t%s\n' "$action" "$source_rel" "$rel" >> "$work/mapped"
done < "$work/tool-raw"

parse_diff "$SNAPSHOT/.rulesync" "$ROOT/.rulesync" "$work/source-raw"
: > "$work/source-paths"
while IFS=$(printf '\t') read -r action rel || [ -n "$action" ]; do
  [ -z "$action" ] && continue
  printf '%s\n' "$rel" >> "$work/source-paths"
done < "$work/source-raw"

if [ ! -s "$work/mapped" ] && [ ! -s "$work/source-paths" ]; then
  exit 0
fi

if [ ! -s "$work/mapped" ]; then
  "$SCRIPT_DIR/rulesync" "$TOOL"
  rulesync_save_snapshot
  exit 0
fi

: > "$work/conflicts"
while IFS=$(printf '\t') read -r action source_rel tool_rel || [ -n "$action" ]; do
  [ -z "$action" ] && continue
  if grep -Fxq "$source_rel" "$work/source-paths"; then
    printf '%s\n' "$source_rel" >> "$work/conflicts"
  fi
done < "$work/mapped"

if [ -s "$work/conflicts" ]; then
  echo ".rulesync and the $TOOL files both changed since the last sync:" >&2
  sed 's/^/  .rulesync\//' "$work/conflicts" >&2
  echo "The commit stopped. Run bin/rulesync/sync-worktree to replace the $TOOL files from .rulesync." >&2
  exit 1
fi

cut -f2 "$work/mapped" > "$work/changed-sources"

if [ "$TOOL" = cursor ]; then
  cp -a "$ROOT/.rulesync" "$work/backup"
  rulesync_run_in "$ROOT" import --targets cursor --features rules,skills
  find "$work/backup" \( -type f -o -type l \) | while IFS= read -r path; do
    rel=${path#"$work/backup/"}
    if grep -Fxq "$rel" "$work/changed-sources"; then
      continue
    fi
    mkdir -p "$(dirname "$ROOT/.rulesync/$rel")"
    rm -f "$ROOT/.rulesync/$rel"
    cp -a "$path" "$ROOT/.rulesync/$rel"
  done
  find "$ROOT/.rulesync" \( -type f -o -type l \) | while IFS= read -r path; do
    rel=${path#"$ROOT/.rulesync/"}
    if [ -e "$work/backup/$rel" ] || grep -Fxq "$rel" "$work/changed-sources"; then
      continue
    fi
    rm -f "$path"
  done
  while IFS= read -r source_rel || [ -n "$source_rel" ]; do
    [ -z "$source_rel" ] && continue
    prev="$work/backup/$source_rel"
    now="$ROOT/.rulesync/$source_rel"
    if [ -f "$prev" ] && [ -f "$now" ] && grep -q '^root: true$' "$prev" && grep -q '^root: false$' "$now"; then
      awk 'BEGIN { done = 0 } !done && /^root: false$/ { print "root: true"; done = 1; next } { print }' "$now" > "$work/rooted"
      mv "$work/rooted" "$now"
    fi
  done < "$work/changed-sources"
  while IFS=$(printf '\t') read -r action source_rel tool_rel || [ -n "$action" ]; do
    [ "$action" = delete ] || continue
    rm -rf "$ROOT/.rulesync/$source_rel"
  done < "$work/mapped"
else
  while IFS=$(printf '\t') read -r action source_rel tool_rel || [ -n "$action" ]; do
    [ -z "$action" ] && continue
    src="$ROOT/.rulesync/$source_rel"
    if [ "$tool_rel" = CLAUDE.md ]; then
      gen="$ROOT/CLAUDE.md"
    else
      gen="$ROOT/.claude/$tool_rel"
    fi
    case "$action" in
      delete) rm -rf "$src" ;;
      add)
        mkdir -p "$(dirname "$src")"
        cp -a "$gen" "$src"
        ;;
      edit)
        if [ -d "$gen" ]; then
          rm -rf "$src"
          mkdir -p "$(dirname "$src")"
          cp -a "$gen" "$src"
        else
          claude_edit "$src" "$gen"
        fi
        ;;
    esac
  done < "$work/mapped"
fi

while IFS= read -r source_rel || [ -n "$source_rel" ]; do
  [ -z "$source_rel" ] && continue
  if [ -e "$ROOT/.rulesync/$source_rel" ]; then
    git -C "$ROOT" add -- ".rulesync/$source_rel"
  else
    git -C "$ROOT" add -A -- ".rulesync/$source_rel" 2>/dev/null || true
  fi
done < "$work/changed-sources"

rulesync_save_snapshot
