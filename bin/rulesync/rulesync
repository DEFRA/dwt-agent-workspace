#!/bin/sh
set -e

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)

usage() {
  echo "Usage: bin/rulesync/rulesync --command=import|generate [--tool=cursor|claude] [--delete]" >&2
  exit 1
}

command=
tool=${RULESYNC_TOOL-}
delete=false

if [ "$#" -lt 1 ]; then
  usage
fi

for arg in "$@"; do
  case "$arg" in
    --command=*)
      command=${arg#--command=}
      ;;
    --tool=*)
      tool=${arg#--tool=}
      ;;
    --delete)
      delete=true
      ;;
    *)
      echo "Unknown argument: $arg" >&2
      usage
      ;;
  esac
done

case "$command" in
  import|generate) ;;
  *)
    echo "Pass --command=import or --command=generate." >&2
    exit 1
    ;;
esac

if [ -z "$tool" ] && [ -f "$ROOT/.env" ]; then
  tool=$(sed -n 's/^RULESYNC_TOOL=//p' "$ROOT/.env" | tail -n 1 | tr -d '\r')
  tool=${tool#\"}
  tool=${tool%\"}
  tool=${tool#\'}
  tool=${tool%\'}
fi

case "$tool" in
  cursor) target=cursor ;;
  claude) target=claudecode ;;
  *)
    echo "Pass --tool=cursor or --tool=claude, or set RULESYNC_TOOL in .env." >&2
    exit 1
    ;;
esac

if [ "$delete" = true ]; then
  set -- --delete
else
  set --
fi

docker build -t dwt-rulesync -f "$SCRIPT_DIR/Dockerfile" "$SCRIPT_DIR"
docker run --rm \
  -u "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  -v "$ROOT:$ROOT" \
  -w "$ROOT" \
  dwt-rulesync "$command" --targets "$target" --features rules,skills,ignore "$@"
